# .env.example — Aegis environment variables (KCH-33)
# Copy to .env and fill in real values before running docker compose.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# API authentication key.  Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AEGIS_API_KEY=change-me-to-a-secret-value

# ---------------------------------------------------------------------------
# Database (postgres:16)
# ---------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# Full DSN used by the app and migration runner.
# In docker-compose this is auto-constructed from the Postgres vars above.
DATABASE_URL=postgresql://aegis:aegis@db:5432/aegis

# ---------------------------------------------------------------------------
# Redis (redis:8)
# ---------------------------------------------------------------------------
AEGIS_REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# Host port to expose the API on.
API_PORT=8000

# Log format: "json" (production) or "kv" (human-readable for local dev).
AEGIS_LOG_FORMAT=json

# Environment tag included in Sentry events.
AEGIS_ENV=production

# ---------------------------------------------------------------------------
# Optional — Sentry error tracking
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Optional — rate limiting tunables
# ---------------------------------------------------------------------------
# AEGIS_RL_SCANS_LIMIT=20
# AEGIS_RL_GATE_LIMIT=60
# AEGIS_RL_WINDOW=60

# ---------------------------------------------------------------------------
# Optional — auth spike alert tunables
# ---------------------------------------------------------------------------
# AEGIS_SPIKE_THRESHOLD=20
# AEGIS_SPIKE_WINDOW=900

# ---------------------------------------------------------------------------
# Dev / test only — NEVER set in production
# ---------------------------------------------------------------------------
# AEGIS_DEV_NO_AUTH=1    # Disable API-key check (local dev only)
# AEGIS_USER_ID=         # Override the resolved user UUID
